@*
  Sticky, full-width header with centered title.
  Keeps Bootstrap + your existing site.css.
*@
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Contact Manager</title>

    <!-- Optional font -->
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@700;800&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <!-- Header that matches the .cm-* CSS -->
    <header class="cm-header">
        <div class="cm-bar">
            <h1 class="cm-title text-center m-0">
                Contact Manager — <span class="fw-normal">Organize Your People</span>
            </h1>
        </div>
    </header>

    <main class="container my-4">
        @RenderBody()
    </main>

    <footer class="border-top footer text-muted">
        <div class="container py-3 small">
            &copy; @DateTime.Now.Year - Contact Manager
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>



