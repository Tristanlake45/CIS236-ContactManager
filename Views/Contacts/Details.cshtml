@model ContactList.Models.Contact
@{
    ViewData["Title"] = "Details";
}

<h1>Contact Details</h1>

<div class="card">
  <table class="table mb-0">
      <tbody>
          <tr><th scope="row">Name:</th><td>@Model.FirstName @Model.LastName</td></tr>
          <tr><th scope="row">Phone:</th><td>@Model.Phone</td></tr>
          <tr><th scope="row">Email:</th><td>@Model.Email</td></tr>
          <tr><th scope="row">Organization:</th><td>@Model.Organization</td></tr>
          <tr><th scope="row">Category:</th><td>@Model.Category?.Name</td></tr>
          <tr><th scope="row">Date Added:</th><td>@Model.DateAdded.ToString("M/d/yyyy 'at' h:mm tt")</td></tr>
      </tbody>
  </table>
  <div class="p-3 border-top">
      <a class="btn btn-dark btn-sm me-2" asp-action="Edit" asp-route-id="@Model.ContactId">Edit</a>
      <a class="btn btn-dark btn-sm me-2" asp-action="Delete" asp-route-id="@Model.ContactId">Delete</a>
      <a class="btn btn-dark btn-sm" asp-action="Index">Home</a>
  </div>
</div>
