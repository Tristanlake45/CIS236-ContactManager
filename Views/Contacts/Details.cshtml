@model ContactList.Models.Contact
@{
    ViewData["Title"] = "Contact Details";
}

<div class="card p-4">
    <div class="d-flex align-items-center gap-3 mb-3">
        <img class="avatar-md"
             src="https://icons.veryicon.com/png/o/miscellaneous/business-icon-6/ios-contact-10.png"
             alt="Contact avatar" />
        <div>
            <h2 class="mb-0">@Model.FirstName @Model.LastName</h2>
            <small class="text-muted">@Model.Category?.Name</small>
        </div>
    </div>

    <table class="table details-table">
        <tbody>
            <tr><th>Email</th><td>@Model.Email</td></tr>
            <tr><th>Phone</th><td>@Model.Phone</td></tr>
            <tr><th>Organization</th><td>@Model.Organization</td></tr>
            <tr><th>Date Added</th><td>@Model.DateAdded.ToLocalTime().ToString("g")</td></tr>
        </tbody>
    </table>

    <div class="mt-3">
        <a class="btn btn-secondary" asp-action="Edit" asp-route-id="@Model.ContactId">Edit</a>
        <a class="btn btn-danger" asp-action="Delete" asp-route-id="@Model.ContactId">Delete</a>
        <a class="btn btn-primary" asp-action="Index">Back</a>
    </div>
</div>


