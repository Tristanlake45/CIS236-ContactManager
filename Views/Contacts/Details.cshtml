@model ContactList.Models.Contact
@{
    ViewData["Title"] = "Details";
}

<h1>Contact Details</h1>

<div class="card">
    <div class="card-body">
        <h4 class="card-title">@Model.FirstName @Model.LastName</h4>
        <p><strong>Phone:</strong> @Model.Phone</p>
        <p><strong>Email:</strong> @Model.Email</p>
        <p><strong>Organization:</strong> @Model.Organization</p>
        <p><strong>Category:</strong> @Model.Category?.Name</p>
        <p><strong>Date Added:</strong> @Model.DateAdded.ToLocalTime().ToString("g")</p>

        <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.ContactId">Edit</a>
        <a class="btn btn-danger" asp-action="Delete" asp-route-id="@Model.ContactId">Delete</a>
        <a class="btn btn-secondary" asp-action="Index">Back</a>
    </div>
</div>
