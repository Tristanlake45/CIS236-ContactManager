@model IEnumerable<ContactList.Models.Contact>
@{
    ViewData["Title"] = "Contacts";
}

<h1>Contacts</h1>

<p>
    <a class="btn btn-primary" asp-controller="Contacts" asp-action="Create">Add Contact</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Phone</th>
            <th>Email</th>
            <th>Category</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>
                <a asp-action="Details" asp-route-id="@item.ContactId">
                    @item.FirstName @item.LastName
                </a>
            </td>
            <td>@item.Phone</td>
            <td>@item.Email</td>
            <td>@item.Category?.Name</td>
            <td>
                <a class="btn btn-sm btn-secondary" asp-action="Edit" asp-route-id="@item.ContactId">Edit</a>
                <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@item.ContactId">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>




