@model IEnumerable<ContactList.Models.Contact>
@{
    ViewData["Title"] = "Contacts";
}

<h1 class="mb-3">Contacts</h1>

<p>
    <a class="btn btn-primary" asp-controller="Contacts" asp-action="Create">Add Contact</a>
</p>

@if (!Model.Any())
{
    <div class="card text-center p-5 my-3">
        <h2 class="mb-2">No contacts yet</h2>
        <p class="text-muted mb-4">Add your first contact to get started.</p>
        <a class="btn btn-primary" asp-action="Create">Add Contact</a>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle mb-0 table-contacts">
            <thead class="table-light">
                <tr>
                    <th style="width:56px;"></th>
                    <th>Name</th>
                    <th>Phone</th>
                    <th>Email</th>
                    <th>Category</th>
                    <th style="width:160px;"></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr class="row-hover">
                    <td data-label="">
                        <img class="avatar"
                             src="https://icons.veryicon.com/png/o/miscellaneous/business-icon-6/ios-contact-10.png"
                             alt="Avatar for @item.FirstName @item.LastName" />
                    </td>
                    <td data-label="Name">
                        <a asp-action="Details" asp-route-id="@item.ContactId" class="fw-semibold text-decoration-none">
                            @item.FirstName @item.LastName
                        </a>
                    </td>
                    <td data-label="Phone">@item.Phone</td>
                    <td data-label="Email">@item.Email</td>
                    <td data-label="Category">
                        <span class="badge-cat">@item.Category?.Name</span>
                    </td>
                    <td class="text-end" data-label="Actions">
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@item.ContactId">Edit</a>
                        <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.ContactId">Delete</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}






