@model ContactList.Models.Contact
@{
    ViewData["Title"] = "Delete Contact";
}

<h1>Delete Contact</h1>

<div class="alert alert-warning">
    <p>Are you sure you want to delete <strong>@Model.FirstName @Model.LastName</strong>?</p>
</div>

<form asp-action="DeleteConfirmed" method="post">
    <input type="hidden" asp-for="ContactId" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Details" asp-route-id="@Model.ContactId" class="btn btn-secondary">Cancel</a>
</form>
